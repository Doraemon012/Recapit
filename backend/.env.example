# Required for the backend to start and persist meeting jobs.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=recapit

# Comma-separated browser origins allowed by FastAPI.
CORS_ORIGINS=http://localhost:3000

# Optional application metadata and API routing.
APP_NAME=Recapit API
API_PREFIX=/api/v1

# Optional: Hugging Face token for pyannote speaker diarization.
# Without this token, the pipeline uses its local speaker-clustering fallback.
HUGGINGFACE_TOKEN=

# Whisper ASR settings.
# Supported model names include tiny, base, small, medium, and large.
WHISPER_MODEL=base
# Use auto to select CUDA when available, otherwise CPU.
WHISPER_DEVICE=auto
WHISPER_VERBOSE=false

# Optional: required for Cohere-powered meeting analytics.
COHERE_API_KEY=

# Optional storage settings retained by the backend settings model.
# The current local pipeline uses MongoDB GridFS for uploaded audio.
STORAGE_BUCKET=
STORAGE_REGION=
